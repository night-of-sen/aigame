# ==============================================================================
# SYNTHPLAY — Production Environment Configuration (Option B: VPS + Cloudflare R2)
# ==============================================================================

# 1. Dual Domains (CRITICAL: Sandbox MUST be a separate root domain to prevent XSS cookie theft)
NEXT_PUBLIC_APP_NAME=SYNTHPLAY
NEXT_PUBLIC_MAIN_DOMAIN=https://synthplay.games
NEXT_PUBLIC_ADMIN_DOMAIN=https://admin.synthplay.games
NEXT_PUBLIC_SANDBOX_DOMAIN=https://synthplay-box.cloud

# 2. PostgreSQL 16 & Redis 7 (Docker local network in Option B)
DATABASE_URL=postgresql://synthplay:change_me_strong_password@postgres:5432/synthplay
REDIS_URL=redis://redis:6379
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_MASTER_KEY=change_me_meili_master_key

# 3. Cloudflare R2 (Zero Egress Bandwidth Fees for Free Games!)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_QUARANTINE=synthplay-quarantine
R2_BUCKET_PROD=synthplay-games-prod
R2_PUBLIC_CDN_URL=https://cdn.synthplay-box.cloud

# 4. Cloudflare Turnstile (Anti-Bot / Anti-Fake-Play Protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# 5. Auth & Admin Security (CRITICAL: Change these before production!)
AUTH_SECRET=change_me_64_char_random_hex
ADMIN_EMAIL=admin@synthplay.games
ADMIN_PASSWORD=change_me_strong_admin_password
ADMIN_API_SECRET=change_me_admin_secret

# Google OAuth 2.0 (Callback URL: https://synthplay.games/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 6. Monetization & Sponsorship Gateways (Mainland Business PayPal + Payoneer + Creem + Ko-fi + Patreon)
# Commercial PayPal (Cross-border >= $5 & B2B Invoices; never accept CN-to-CN)
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=your_paypal_business_client_id
PAYPAL_CLIENT_SECRET=your_paypal_business_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# Creem MoR (Supports China Individual Developers, 3.9% + $0.40, VAT handled)
CREEM_API_KEY=your_creem_api_key
CREEM_WEBHOOK_SECRET=your_creem_webhook_secret
CREEM_PRODUCT_PRO=
CREEM_PRODUCT_GOLD=
CREEM_PRODUCT_DIAMOND=

# Ko-fi (Direct to Business PayPal, 0% platform fee on tips)
KOFI_VERIFICATION_TOKEN=your_kofi_verification_token
NEXT_PUBLIC_KOFI_URL=

# Patreon (Direct payout to Payoneer USD Receiving Account)
PATREON_WEBHOOK_SECRET=your_patreon_webhook_secret
NEXT_PUBLIC_PATREON_URL=
NEXT_PUBLIC_PAYPAL_ME_URL=

# 7. AI Auto-Translation Pipeline (gemini | deepseek | openai)
AI_TRANSLATE_PROVIDER=gemini
AI_TRANSLATE_API_KEY=your_llm_api_key
AI_TRANSLATE_MODEL=gemini-2.0-flash
