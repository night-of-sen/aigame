FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@10.0.0 --activate
WORKDIR /app

COPY pnpm-workspace.yaml package.json ./
COPY packages ./packages
COPY apps/web ./apps/web

ARG NEXT_PUBLIC_MAIN_DOMAIN=https://synthplay.games
ARG NEXT_PUBLIC_ADMIN_DOMAIN=https://admin.synthplay.games
ARG NEXT_PUBLIC_SANDBOX_DOMAIN=https://synthplay-box.cloud
ARG NEXT_PUBLIC_ADSENSE_CLIENT=
ARG NEXT_PUBLIC_ADSENSE_SLOT_HALL=
ARG NEXT_PUBLIC_ADSENSE_SLOT_GAME=
ARG NEXT_PUBLIC_TURNSTILE_SITE_KEY=
ARG NEXT_PUBLIC_KOFI_URL=
ARG NEXT_PUBLIC_PATREON_URL=
ARG NEXT_PUBLIC_AFFILIATE_CURSOR=
ARG NEXT_PUBLIC_AFFILIATE_MESHY=
ARG NEXT_PUBLIC_AFFILIATE_SUNO=
ARG NEXT_PUBLIC_AFFILIATE_HOSTINGER=
ENV NEXT_PUBLIC_MAIN_DOMAIN=$NEXT_PUBLIC_MAIN_DOMAIN
ENV NEXT_PUBLIC_ADMIN_DOMAIN=$NEXT_PUBLIC_ADMIN_DOMAIN
ENV NEXT_PUBLIC_SANDBOX_DOMAIN=$NEXT_PUBLIC_SANDBOX_DOMAIN
ENV NEXT_PUBLIC_ADSENSE_CLIENT=$NEXT_PUBLIC_ADSENSE_CLIENT
ENV NEXT_PUBLIC_ADSENSE_SLOT_HALL=$NEXT_PUBLIC_ADSENSE_SLOT_HALL
ENV NEXT_PUBLIC_ADSENSE_SLOT_GAME=$NEXT_PUBLIC_ADSENSE_SLOT_GAME
ENV NEXT_PUBLIC_TURNSTILE_SITE_KEY=$NEXT_PUBLIC_TURNSTILE_SITE_KEY
ENV NEXT_PUBLIC_KOFI_URL=$NEXT_PUBLIC_KOFI_URL
ENV NEXT_PUBLIC_PATREON_URL=$NEXT_PUBLIC_PATREON_URL
ENV NEXT_PUBLIC_AFFILIATE_CURSOR=$NEXT_PUBLIC_AFFILIATE_CURSOR
ENV NEXT_PUBLIC_AFFILIATE_MESHY=$NEXT_PUBLIC_AFFILIATE_MESHY
ENV NEXT_PUBLIC_AFFILIATE_SUNO=$NEXT_PUBLIC_AFFILIATE_SUNO
ENV NEXT_PUBLIC_AFFILIATE_HOSTINGER=$NEXT_PUBLIC_AFFILIATE_HOSTINGER

RUN pnpm install --no-frozen-lockfile
RUN pnpm --filter @synthplay/web build

EXPOSE 3000
CMD ["pnpm", "--filter", "@synthplay/web", "start"]
