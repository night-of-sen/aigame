{
  "name": "synthplay-monorepo",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @synthplay/web dev",
    "dev:admin": "pnpm --filter @synthplay/admin dev",
    "build": "pnpm --filter @synthplay/web build && pnpm --filter @synthplay/admin build",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:push": "pnpm --filter @synthplay/db db:push",
    "db:generate": "pnpm --filter @synthplay/db db:generate"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  }
}
